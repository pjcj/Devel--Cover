use strict;
use warnings;

my @r;
for my $i (0 .. 1) {
  my ($x, $y) = ($i, 1 - $i);
  my $s = "axb";
  $s =~ s/x/ my $t = $x || $y; $t /e;
  push @r, $s;
  $s = "axb";
  $s =~ s/x/ $x && $y ? "t" : "f" /e;
  push @r, $s;
  $s = "axb";
  $s =~ s/x/ my $v = "n"; $v = "p" if $x; $v /e;
  push @r, $s;
}
print "@r\n";
