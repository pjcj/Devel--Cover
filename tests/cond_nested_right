# Condition coverage for a logop whose right operand is a nested operator.
# When the nested operator short-circuits, perl jumps past the op the outer
# operator watches, so the outer operator's right value must be recorded at
# the short circuit.  Each call order below runs the short circuit first and
# then reaches the watched op with the opposite value, so a stale entry
# resolved there would credit the wrong column.  The left-nested and dor
# forms are controls: perl never jumps past their watched ops.

use strict;
use warnings;

sub and_or_if {
  my ($x, $y, $z) = @_;
  return 1 if $x && ($y || $z);
  0
}

sub or_and_if {
  my ($x, $y, $z) = @_;
  return 1 if $x || ($y && $z);
  0
}

sub and_or_block {
  my ($x, $y, $z) = @_;
  if ($x && ($y || $z)) {
    return 1;
  }
  0
}

sub and_or_unless {
  my ($x, $y, $z) = @_;
  return 1 unless $x && ($y || $z);
  0
}

sub and_or_while {
  my ($x, $y, $z) = @_;
  my $n = 0;
  while ($x && ($y || $z)) {
    $n++;
    $y = 0;
    $z = 0;
  }
  $n
}

sub and_and_if {
  my ($x, $y, $z) = @_;
  return 1 if $x && ($y && $z);
  0
}

sub and_or_chain {
  my ($x, $y, $z, $w) = @_;
  return 1 if $x && ($y || $z || $w);
  0
}

sub and_and_value {
  my ($x, $y, $z, $w) = @_;
  my $r = $x && ($y && $z) && $w;
  $r
}

sub or_and_left {
  my ($x, $y, $z) = @_;
  return 1 if ($x || $y) && $z;
  0
}

sub and_dor_if {
  my ($x, $y, $z) = @_;
  return 1 if $x && ($y // $z);
  0
}

sub main {
  # Calls are pushed into @r so each decision is exercised in non-void
  # context.
  my @r;

  # $x && ($y || $z) as a statement modifier.  The (1, 1, X) row ends at
  # the inner ||, then (1, 0, 0) reaches the watched op with false.
  push @r, and_or_if(1, 1, 0);
  push @r, and_or_if(1, 0, 0);
  push @r, and_or_if(1, 0, 1);
  push @r, and_or_if(0, 0, 0);

  # The mirror, $x || ($y && $z).  The (0, 0, X) row ends at the inner &&,
  # then (0, 1, 1) reaches the watched op with true.
  push @r, or_and_if(0, 0, 0);
  push @r, or_and_if(0, 1, 1);
  push @r, or_and_if(0, 1, 0);
  push @r, or_and_if(1, 0, 0);

  # The if block form.
  push @r, and_or_block(1, 1, 0);
  push @r, and_or_block(1, 0, 0);
  push @r, and_or_block(1, 0, 1);
  push @r, and_or_block(0, 0, 0);

  # The unless form.
  push @r, and_or_unless(1, 1, 0);
  push @r, and_or_unless(1, 0, 0);
  push @r, and_or_unless(1, 0, 1);
  push @r, and_or_unless(0, 0, 0);

  # The while form.  The first iteration short-circuits at the inner ||
  # and the second reaches the watched op with false.
  push @r, and_or_while(1, 1, 0);
  push @r, and_or_while(1, 0, 1);
  push @r, and_or_while(0, 0, 0);

  # Same type nested, $x && ($y && $z).  The (1, 0, X) row ends at the
  # inner &&, then (1, 1, 1) reaches the watched op with true.
  push @r, and_and_if(1, 0, 0);
  push @r, and_and_if(1, 1, 1);
  push @r, and_and_if(1, 1, 0);
  push @r, and_and_if(0, 0, 0);

  # A chain inside the parentheses.  The (1, 1, X, X) row ends at the
  # innermost ||, past the outer || as well as the watched op.
  push @r, and_or_chain(1, 1, 0, 0);
  push @r, and_or_chain(1, 0, 0, 0);
  push @r, and_or_chain(1, 0, 1, 0);
  push @r, and_or_chain(1, 0, 0, 1);
  push @r, and_or_chain(0, 0, 0, 0);

  # Same type nested in value context.  The (1, 0, X, X) row ends at the
  # innermost &&, past the outer && the nested one is watching.
  push @r, and_and_value(1, 0, 1, 1);
  push @r, and_and_value(1, 1, 1, 0);
  push @r, and_and_value(1, 1, 0, 1);
  push @r, and_and_value(1, 1, 1, 1);
  push @r, and_and_value(0, 0, 0, 0);

  # Controls.
  push @r, or_and_left(1, 0, 1);
  push @r, or_and_left(0, 1, 0);
  push @r, or_and_left(0, 0, 0);
  push @r, and_dor_if(1, 1,     0);
  push @r, and_dor_if(1, 0,     0);
  push @r, and_dor_if(1, undef, 1);
  push @r, and_dor_if(1, undef, 0);
  push @r, and_dor_if(0, 0,     0);
}

main();
