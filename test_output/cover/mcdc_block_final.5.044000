60                                               # context.
61             1                           1     my @r;
62                                             
63                                               # A three-atom && chain ending a grep block.
64             1                                 push @r, grep_and3([1, 1, 1], [1, 1, 0], [1, 0, 0], [0, 0, 0]);
65                                             
66                                               # A two-atom || ending a grep block.
67             1                                 push @r, grep_or2([1, 0], [0, 1], [0, 0]);
68                                             
69                                               # A mixed chain with a leaf right operand ending a map block.
70             1                                 push @r, map_and_or([1, 1, 0], [1, 0, 1], [1, 0, 0], [0, 0, 1], [0, 0, 0]);
71                                             
72                                               # A chain ending a sort comparator.  Both elements are the same, so
73                                               # the row does not depend on which is $a.
