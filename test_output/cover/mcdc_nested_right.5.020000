10                                             # MC/DC for a decision in boolean context whose right operand is a nested
11                                             # operator.  When the nested operator short-circuits and that decides the
12                                             # whole decision, perl jumps straight to the consumer's branch, past the
13                                             # op the outer operator watches, so the row must be recorded at the
14                                             # short-circuit.  The four-atom chain and the value-context form are the
15                                             # controls: their rows are recorded through the outer operator.
16                                             
17             1                           1   use strict;
               1                               
               1                               
18             1                           1   use warnings;
               1                               
               1                               
19                                             
20                                             sub and_or_if {
21             4                           4     my ($x, $y, $z) = @_;
22             4    100    100    100            return 1 if $x && ($y || $z);
                           100                 
23             2                                 0
24                                             }
25                                             
26                                             sub or_and_if {
27             4                           4     my ($x, $y, $z) = @_;
28             4    100    100    100            return 1 if $x || ($y && $z);
                           100                 
29             2                                 0
30                                             }
31                                             
32                                             sub and_or_block {
33             4                           4     my ($x, $y, $z) = @_;
34             4    100    100    100            if ($x && ($y || $z)) {
                           100                 
35             2                                   return 1;
36                                               }
37                                               0
38             2                               }
39                                             
40                                             sub and_or_unless {
41             4                           4     my ($x, $y, $z) = @_;
42             4    100    100    100            return 1 unless $x && ($y || $z);
                           100                 
43             2                                 0
44                                             }
45                                             
46                                             sub and_or_and {
47             5                           5     my ($x, $y, $z, $w) = @_;
48             5    100    100    100            return 1 if $x && ($y || ($z && $w));
                           100                 
                           100                 
49             3                                 0
50                                             }
51                                             
52                                             sub and_or_chain {
53             5                           5     my ($x, $y, $z, $w) = @_;
54             5    100    100    100            return 1 if $x && ($y || $z) && $w;
                           100                 
                           100                 
55             3                                 0
