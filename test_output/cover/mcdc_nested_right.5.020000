57                                             
58                                             sub and_or_value {
59             4                           4     my ($x, $y, $z) = @_;
60             4           100    100            return $x && ($y || $z);
                           100                 
61                                             }
62                                             
63                                             sub main {
64                                               # Calls are pushed into @r so each decision is exercised in non-void
65                                               # context.
66             1                           1     my @r;
67                                             
68                                               # $x && ($y || $z) as a statement modifier, every short-circuit row.
69                                               # The (1, 1, X) row ends at the inner ||.
70             1                                 push @r, and_or_if(1, 1, 0);
71             1                                 push @r, and_or_if(1, 0, 1);
72             1                                 push @r, and_or_if(1, 0, 0);
73             1                                 push @r, and_or_if(0, 0, 0);
74                                             
75                                               # The mirror, $x || ($y && $z).  The (0, 0, X) row ends at the inner &&.
76             1                                 push @r, or_and_if(1, 0, 0);
77             1                                 push @r, or_and_if(0, 1, 1);
78             1                                 push @r, or_and_if(0, 1, 0);
79             1                                 push @r, or_and_if(0, 0, 0);
80                                             
81                                               # The if block form.
82             1                                 push @r, and_or_block(1, 1, 0);
83             1                                 push @r, and_or_block(1, 0, 1);
84             1                                 push @r, and_or_block(1, 0, 0);
85             1                                 push @r, and_or_block(0, 0, 0);
86                                             
87                                               # The unless form.
88             1                                 push @r, and_or_unless(1, 1, 0);
89             1                                 push @r, and_or_unless(1, 0, 1);
90             1                                 push @r, and_or_unless(1, 0, 0);
91             1                                 push @r, and_or_unless(0, 0, 0);
92                                             
93                                               # Two nested levels.  The (1, 1, X, X) row ends at the ||, the
94                                               # (1, 0, 0, X) row at the innermost &&.
95             1                                 push @r, and_or_and(1, 1, 0, 0);
96             1                                 push @r, and_or_and(1, 0, 1, 1);
97             1                                 push @r, and_or_and(1, 0, 1, 0);
98             1                                 push @r, and_or_and(1, 0, 0, 0);
99             1                                 push @r, and_or_and(0, 0, 0, 0);
100                                            
101                                              # A four-atom chain around the nested operator.  The inner || exits to
102                                              # the outer &&, so every row goes through it.
103            1                                 push @r, and_or_chain(1, 1, 0, 1);
104            1                                 push @r, and_or_chain(1, 0, 1, 1);
105            1                                 push @r, and_or_chain(1, 0, 0, 1);
106            1                                 push @r, and_or_chain(0, 0, 0, 1);
107            1                                 push @r, and_or_chain(1, 1, 0, 0);
108                                            
109                                              # The same decision in value context.
110            1                                 push @r, and_or_value(1, 1, 0);
111            1                                 push @r, and_or_value(1, 0, 1);
112            1                                 push @r, and_or_value(1, 0, 0);
113            1                                 push @r, and_or_value(0, 0, 0);
114                                            }
115                                            
116            1                               main();


