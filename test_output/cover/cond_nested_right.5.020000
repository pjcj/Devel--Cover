49             3                          my ($x, $y, $z) = @_;
50             3                          my $n = 0;
51             3    100    100            while ($x && ($y || $z)) {
                           100          
52             2                            $n++;
53             2                            $y = 0;
54             2                            $z = 0;
55                                        }
56                                        $n
57             3                        }
58                                      
