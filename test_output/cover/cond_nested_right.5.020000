122            1                          push @r, and_or_while(1, 1, 0);
123            1                          push @r, and_or_while(1, 0, 1);
124            1                          push @r, and_or_while(0, 0, 0);
125                                     
126                                       # Same type nested, $x && ($y && $z).  The (1, 0, X) row ends at the
127                                       # inner &&, then (1, 1, 1) reaches the watched op with true.
128            1                          push @r, and_and_if(1, 0, 0);
129            1                          push @r, and_and_if(1, 1, 1);
130            1                          push @r, and_and_if(1, 1, 0);
131            1                          push @r, and_and_if(0, 0, 0);
132                                     
133                                       # A chain inside the parentheses.  The (1, 1, X, X) row ends at the
134                                       # innermost ||, past the outer || as well as the watched op.
135            1                          push @r, and_or_chain(1, 1, 0, 0);
136            1                          push @r, and_or_chain(1, 0, 0, 0);
137            1                          push @r, and_or_chain(1, 0, 1, 0);
138            1                          push @r, and_or_chain(1, 0, 0, 1);
139            1                          push @r, and_or_chain(0, 0, 0, 0);
140                                     
141                                       # Same type nested in value context.  The (1, 0, X, X) row ends at the
142                                       # innermost &&, past the outer && the nested one is watching.
143            1                          push @r, and_and_value(1, 0, 1, 1);
144            1                          push @r, and_and_value(1, 1, 1, 0);
145            1                          push @r, and_and_value(1, 1, 0, 1);
146            1                          push @r, and_and_value(1, 1, 1, 1);
147            1                          push @r, and_and_value(0, 0, 0, 0);
148                                     
149                                       # Controls.
150            1                          push @r, or_and_left(1, 0, 1);
151            1                          push @r, or_and_left(0, 1, 0);
152            1                          push @r, or_and_left(0, 0, 0);
153            1                          push @r, and_dor_if(1, 1,     0);
154            1                          push @r, and_dor_if(1, 0,     0);
155            1                          push @r, and_dor_if(1, undef, 1);
156            1                          push @r, and_dor_if(1, undef, 0);
157            1                          push @r, and_dor_if(0, 0,     0);
158                                     }
