11                                      # Condition coverage for a logop whose right operand is a nested operator.
12                                      # When the nested operator short-circuits, perl jumps past the op the outer
13                                      # operator watches, so the outer operator's right value must be recorded at
14                                      # the short circuit.  Each call order below runs the short circuit first and
15                                      # then reaches the watched op with the opposite value, so a stale entry
16                                      # resolved there would credit the wrong column.  The left-nested and dor
17                                      # forms are controls: perl never jumps past their watched ops.
18                                      
19             1                    1   use strict;
               1                        
               1                        
20             1                    1   use warnings;
               1                        
               1                        
21                                      
22                                  4   sub and_or_if {
23             4                          my ($x, $y, $z) = @_;
24             4    100    100            return 1 if $x && ($y || $z);
                           100          
25             2                          0
26                                      }
27                                      
28                                  4   sub or_and_if {
29             4                          my ($x, $y, $z) = @_;
30             4    100    100            return 1 if $x || ($y && $z);
                           100          
31             2                          0
32                                      }
33                                      
34                                  4   sub and_or_block {
35             4                          my ($x, $y, $z) = @_;
36             4    100    100            if ($x && ($y || $z)) {
                           100          
37             2                            return 1;
38                                        }
39                                        0
40             2                        }
41                                      
