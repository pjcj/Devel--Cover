90                                        # Calls are pushed into @r so each decision is exercised in non-void
91                                        # context.
92             1                          my @r;
93                                      
94                                        # $x && ($y || $z) as a statement modifier.  The (1, 1, X) row ends at
95                                        # the inner ||, then (1, 0, 0) reaches the watched op with false.
96             1                          push @r, and_or_if(1, 1, 0);
97             1                          push @r, and_or_if(1, 0, 0);
98             1                          push @r, and_or_if(1, 0, 1);
99             1                          push @r, and_or_if(0, 0, 0);
100                                     
101                                       # The mirror, $x || ($y && $z).  The (0, 0, X) row ends at the inner &&,
102                                       # then (0, 1, 1) reaches the watched op with true.
103            1                          push @r, or_and_if(0, 0, 0);
104            1                          push @r, or_and_if(0, 1, 1);
105            1                          push @r, or_and_if(0, 1, 0);
106            1                          push @r, or_and_if(1, 0, 0);
107                                     
